						if b then b.Position = pos; if it.kind == "DeadPlayer" then dC += 1 else eC += 1 end end
					end
				end
			end
		end
		hideRadarUnusedBlips(); radarStatusLbl.Text = string.format("P:%d  NPC/Q:%d  X:%d", pC, eC, dC)
		if rState.soundOn and nearest <= RADAR_RADIUS_STUDS then
