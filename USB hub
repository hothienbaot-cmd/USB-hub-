			for c=1,8 do
				local x, y, radPx = pad+(c-1)*step, pad+(r-1)*step, math.max(1, math.floor(cPx*0.15))
				cells[r][c] = rad(new("Frame", {Size=UDim2.new(0,cPx,0,cPx),Position=UDim2.new(0,x,0,y),BackgroundColor3=bbGrid[r] and bbGrid[r][c] or Color3.fromRGB(30,48,92),BorderSizePixel=0,ZIndex=2}, board), radPx)
				shds[r][c] = rad(new("Frame", {Size=UDim2.new(0,cPx,0,cPx),Position=UDim2.new(0,x,0,y),BackgroundColor3=Color3.fromRGB(255,255,255),BackgroundTransparency=0.5,BorderSizePixel=0,Visible=false,ZIndex=4}, board), radPx)
				stk(shds[r][c], Color3.fromRGB(255,255,255), 1.2, 0.2)
			end
		end
	end

	local function clearSnap() snap = nil; for r=1,8 do for c=1,8 do if shds[r] and shds[r][c] then shds[r][c].Visible = false end end end end
	local function stopDrag() drag, ghost.Visible = nil, false; clearSnap() end
	local function topLeft(pos, shp)
		local r, c = #shp, #shp[1]
		local tw, th = c*cPx+(c-1)*(step-cPx), r*cPx+(r-1)*(step-cPx)
		return pos.X-tw*0.5, pos.Y-th*0.5-22, tw, th
	end
	local function canPut(shp, sr, sc)
		if not shp or not sr or not sc then return false end
		local r, c = #shp, #shp[1]
		if sr<1 or sc<1 or sr+r-1>8 or sc+c-1>8 then return false end
		for i=1,r do for j=1,c do if shp[i][j]==1 and bbGrid[sr+i-1][sc+j-1] then return false end end end
		return true
	end
	local function updSnap(pos, it)
		clearSnap(); if not pos or not it then return end
		local tlX, tlY = topLeft(pos, it.shp); local bp = board.AbsolutePosition
		local c, r = math.floor((tlX-(bp.X+pad))/step+0.5)+1, math.floor((tlY-(bp.Y+pad))/step+0.5)+1
		if not canPut(it.shp, r, c) then return end
		snap = {r=r, c=c}
		for i=1,#it.shp do for j=1,#it.shp[1] do if it.shp[i][j]==1 and shds[r+i-1] and shds[r+i-1][c+j-1] then
			shds[r+i-1][c+j-1].BackgroundColor3, shds[r+i-1][c+j-1].Visible = it.col, true
		end end end
	end
	local function syncHud() if bbScore>bbBest then bbBest=bbScore end; scoreLbl.Text, bestLbl.Text = tostring(bbScore), "👑 "..bbBest end
	local function drawBoard() for r=1,8 do for c=1,8 do if cells[r] and cells[r][c] then cells[r][c].BackgroundColor3 = bbGrid[r][c] or Color3.fromRGB(30,48,92) end end end end
	local function hasMove()
		for i=1,3 do local it=bbTray[i]; if it then for r=1,8 do for c=1,8 do if canPut(it.shp,r,c) then return true end end end end end
		return false
	end
	local function gameOver() stopDrag(); syncHud(); endLbl.Text="Điểm: "..bbScore.."\nBest: "..bbBest; over.Visible=true end
	local function clearLines()
		local fr, fc = {}, {}
		for r=1,8 do local ok=true; for c=1,8 do if not bbGrid[r][c] then ok=false; break end end; if ok then table.insert(fr,r) end end
		for c=1,8 do local ok=true; for r=1,8 do if not bbGrid[r][c] then ok=false; break end end; if ok then table.insert(fc,c) end end
		for _,r in ipairs(fr) do for c=1,8 do bbGrid[r][c]=nil end end
		for _,c in ipairs(fc) do for r=1,8 do bbGrid[r][c]=nil end end
		return #fr + #fc
	end
	local function randBlock()
		local col = BB_COL[math.random(#BB_COL)]
		if bbCfg.lucky then
			local pool = {}
			for _, sh in ipairs(BB_SHP) do
				local ok=false; for r=1,8 do for c=1,8 do if canPut(sh,r,c) then ok=true; break end end; if ok then break end end
				if ok then
					local n=0; for _,row in ipairs(sh) do for _,v in ipairs(row) do if v==1 then n+=1 end end end
					for _=1,(n<=4 and 4 or 1) do table.insert(pool, sh) end
				end
			end
			if #pool>0 then return {shp=pool[math.random(#pool)], col=col} end
		end
		return {shp=BB_SHP[math.random(#BB_SHP)], col=col}
	end
	local function drawTray()
		for i=1,3 do local sl, it = slots[i], bbTray[i]
			for _,ch in ipairs(sl:GetChildren()) do ch:Destroy() end
			if it and not (drag and drag.idx==i) then
				local r, c = #it.shp, #it.shp[1]
				local mp = math.min(11, math.max(4, math.floor(38/math.max(r,c))))
				local ox, oy = math.floor((sl.AbsoluteSize.X-(c*(mp+2)-2))*0.5), math.floor((sl.AbsoluteSize.Y-(r*(mp+2)-2))*0.5)
				for i2=1,r do for j2=1,c do if it.shp[i2][j2]==1 then
					rad(new("Frame",{Size=UDim2.new(0,mp,0,mp),Position=UDim2.new(0,ox+(j2-1)*(mp+2),0,oy+(i2-1)*(mp+2)),BackgroundColor3=it.col,BorderSizePixel=0},sl),2)
				end end end
			end
		end
	end
	local function refill() for i=1,3 do if bbTray[i] then drawTray(); return end end; for i=1,3 do bbTray[i]=randBlock() end; drawTray() end
	local function reset()
		over.Visible, bbScore, bbCombo = false, 0, 0; stopDrag()
		for r=1,8 do bbGrid[r]={} end; for i=1,3 do bbTray[i]=randBlock() end
		statLbl.Text="Kéo tới bóng mờ rồi thả"; syncHud(); drawBoard(); drawTray()
		if not hasMove() then gameOver() end
	end
	local function showGhost(it, pos)
		for _,ch in ipairs(ghost:GetChildren()) do ch:Destroy() end
		local tlX, tlY, tw, th = topLeft(pos, it.shp)
		ghost.Size, ghost.Position, ghost.Visible = UDim2.new(0,tw,0,th), UDim2.new(0,tlX,0,tlY), true
		for i=1,#it.shp do for j=1,#it.shp[1] do if it.shp[i][j]==1 then
			rad(new("Frame",{Size=UDim2.new(0,cPx,0,cPx),Position=UDim2.new(0,(j-1)*step,0,(i-1)*step),BackgroundColor3=it.col,BackgroundTransparency=0.08,BorderSizePixel=0},ghost),math.max(1,math.floor(cPx*0.15)))
		end end end
		updSnap(pos, it)
	end
	local function dropAt(pos)
		if not drag then return end
		local d = drag; local p = (pos and (pos.X~=0 or pos.Y~=0)) and pos or d.pos
		updSnap(p, d.it); local t = snap; stopDrag()
		if t and canPut(d.it.shp, t.r, t.c) then
			for i=1,#d.it.shp do for j=1,#d.it.shp[1] do if d.it.shp[i][j]==1 then bbGrid[t.r+i-1][t.c+j-1]=d.it.col end end end
			bbTray[d.idx] = nil
			local ln, m = clearLines(), bbCfg.x2 and 2 or 1
			if ln>0 then bbCombo+=1; local e=BB_PTS[math.min(bbCombo,10)]*ln*m; bbScore+=e; statLbl.Text="🔥 Combo "..bbCombo.." +"..e
			else bbCombo=0; local e=30*m; bbScore+=e; statLbl.Text="+"..e.." điểm" end
			syncHud(); drawBoard(); refill(); if not hasMove() then gameOver() end
		else drawTray(); statLbl.Text="Khối về khay" end
	end

	for i=1,3 do
		table.insert(bbConns, slots[i].InputBegan:Connect(function(inp)
			if drag or over.Visible or not bbCfg.vis or not bbTray[i] then return end
			if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
				drag = {idx=i, it=bbTray[i], pos=inp.Position}; drawTray(); showGhost(drag.it, inp.Position)
			end
		end))
	end
	table.insert(bbConns, Uis.InputChanged:Connect(function(inp)
		if drag and (inp.UserInputType==Enum.UserInputType.MouseMovement or inp.UserInputType==Enum.UserInputType.Touch) then
			drag.pos = inp.Position; local x, y = topLeft(inp.Position, drag.it.shp)
			ghost.Position = UDim2.new(0,x,0,y); updSnap(inp.Position, drag.it)
		end
	end))
	table.insert(bbConns, Uis.InputEnded:Connect(function(inp)
		if drag and (inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch) then dropAt(inp.Position) end
	end))
	table.insert(bbConns, Uis.TouchEnded:Connect(function(t) if drag then dropAt(t and t.Position) end end))
	table.insert(bbConns, win:GetPropertyChangedSignal("AbsolutePosition"):Connect(syncSideBarPos))
	table.insert(bbConns, win:GetPropertyChangedSignal("AbsoluteSize"):Connect(syncSideBarPos))

	local function refreshBtns()
		x2Btn.Text="x2:"..(bbCfg.x2 and "BẬT" or "TẮT"); x2Btn.BackgroundColor3=bbCfg.x2 and Color3.fromRGB(36,145,88) or Color3.fromRGB(16,54,38)
		lkBtn.Text="🍀:"..(bbCfg.lucky and "BẬT" or "TẮT"); lkBtn.BackgroundColor3=bbCfg.lucky and Color3.fromRGB(36,145,88) or Color3.fromRGB(16,54,38)
		loBtn.Text=bbCfg.lock and "🔒 Lock" or "🔓 Unlock"; loBtn.BackgroundColor3=bbCfg.lock and Color3.fromRGB(145,45,45) or Color3.fromRGB(36,145,88); win.Draggable=not bbCfg.lock
		viBtn.Text=bbCfg.vis and "👁️ Ẩn" or "👁️ Hiện"; viBtn.BackgroundColor3=bbCfg.vis and Color3.fromRGB(28,96,66) or Color3.fromRGB(92,58,18)
		local r = math.clamp((bbCfg.size-100)/200, 0, 1)
		fill.Size, thumb.Position, szLbl.Text = UDim2.new(r,0,1,0), UDim2.new(r,0,0.5,0), "Size: "..bbCfg.size.." (100-300)"
	end
	local function setSize(v)
		bbCfg.size = math.clamp(math.floor(v), 100, 300)
		win.Size = UDim2.new(0, bbCfg.size, 0, math.floor(bbCfg.size*1.32))
		refreshBtns(); task.defer(function() syncSideBarPos(); buildGrid(); drawTray() end)
	end
	local sliding = false
	local function slideX(x) setSize(100 + math.clamp((x-track.AbsolutePosition.X)/math.max(1,track.AbsoluteSize.X),0,1)*200) end
	table.insert(bbConns, track.InputBegan:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then sliding=true; slideX(inp.Position.X) end end))
	table.insert(bbConns, Uis.InputChanged:Connect(function(inp) if sliding and (inp.UserInputType==Enum.UserInputType.MouseMovement or inp.UserInputType==Enum.UserInputType.Touch) then slideX(inp.Position.X) end end))
	table.insert(bbConns, Uis.InputEnded:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then sliding=false end end))

	local function setVis(s) bbCfg.vis, win.Visible, bar.Visible = s, s, s; if not s then stopDrag(); drawTray() end; refreshBtns() end
	bbSetVis = setVis
	x2Btn.MouseButton1Click:Connect(function() bbCfg.x2=not bbCfg.x2; refreshBtns() end)
	lkBtn.MouseButton1Click:Connect(function() bbCfg.lucky=not bbCfg.lucky; refreshBtns() end)
    loBtn.MouseButton1Click:Connect(function() bbCfg.lock=not bbCfg.lock; refreshBtns() end)
	viBtn.MouseButton1Click:Connect(function() setVis(not bbCfg.vis) end)
	hideBtn.MouseButton1Click:Connect(function() setVis(false) end)
	closeBtn.MouseButton1Click:Connect(destroyBlockBlast); retryBtn.MouseButton1Click:Connect(reset)
	refreshBtns(); task.defer(function() syncSideBarPos(); buildGrid(); reset() end)
end

