local function getRadarOriginCFrame()
	local cam, hrp = Wsp.CurrentCamera, hrpOf(LP)
	if cam and hrp then
		local flat = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
		return flat.Magnitude > 0.001 and CFrame.lookAt(hrp.Position, hrp.Position + flat.Unit) or CFrame.new(hrp.Position)
	end
	return hrp and hrp.CFrame
end
local function worldToRadarCoord(originCF, targetPos, halfRadiusPx)
	local flat = Vector3.new(targetPos.X - originCF.Position.X, 0, targetPos.Z - originCF.Position.Z)
	if flat.Magnitude > RADAR_RADIUS_STUDS or flat.Magnitude < 0.05 then return nil end
	local loc = originCF:VectorToObjectSpace(flat)
	local nx, ny = math.clamp(loc.X / RADAR_RADIUS_STUDS, -1, 1), math.clamp(loc.Z / RADAR_RADIUS_STUDS, -1, 1)
	if nx*nx + ny*ny > 1 then return nil end
	return UDim2.new(0.5 + (nx*(halfRadiusPx-5))/halfRadiusPx*0.5, 0, 0.5 + (ny*(halfRadiusPx-5))/halfRadiusPx*0.5, 0)
end
