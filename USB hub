			done = false; if expr == "" then if k == "-" then expr = "-" end; refDisp(); return end
			local lc = expr:sub(-1,-1); expr = isOp(lc) and (expr:sub(1,-2)..k) or (lc=="," and expr.."0"..k or expr..k); refDisp(); return
