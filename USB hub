local nexusTglBtn, nexusGuiInstance, nexusCharConn, nexusBv, nexusBg = nil
local nexusFlyEnabled, nexusSpeed, nexusVertHold, nexusMoveConn = false, 1, 0, nil
local function cleanNexusForces()
	if nexusBv then pcall(function() nexusBv:Destroy() end); nexusBv = nil end
	if nexusBg then pcall(function() nexusBg:Destroy() end); nexusBg = nil end
	local hrp, hum = hrpOf(LP), humOf(LP)
	if hrp then for _, o in ipairs(hrp:GetChildren()) do if o.Name == "NexusBV" or o.Name == "NexusBG" then pcall(function() o:Destroy() end) end end end
	if hum then pcall(function() hum.PlatformStand = false end) end
end
local function ensureNexusForces()
	local char, hrp, hum = LP.Character, hrpOf(LP), humOf(LP)
	if not hrp or not hum or hum.Health <= 0 then return nil end
	if not nexusBv or nexusBv.Parent ~= hrp then
		if nexusBv then pcall(function() nexusBv:Destroy() end) end
		nexusBv = new("BodyVelocity", {Name="NexusBV", MaxForce=Vector3.new(1e8,1e8,1e8), Velocity=Vector3.zero}, hrp)
	end
	if not nexusBg or nexusBg.Parent ~= hrp then
		if nexusBg then pcall(function() nexusBg:Destroy() end) end
		nexusBg = new("BodyGyro", {Name="NexusBG", MaxTorque=Vector3.new(1e8,1e8,1e8), P=3e4, D=500, CFrame=hrp.CFrame}, hrp)
	end
	return char, hrp, hum
end
local function stopNexusLoop()
	nexusFlyEnabled, nexusVertHold = false, 0
	if nexusMoveConn then nexusMoveConn:Disconnect(); nexusMoveConn = nil end
	cleanNexusForces()
end
local function startNexusLoop()
	if nexusMoveConn then nexusMoveConn:Disconnect() end
	nexusMoveConn = RunSvc.RenderStepped:Connect(function()
		if not nexusFlyEnabled then return end
		local char, hrp, hum = ensureNexusForces(); local cam = Wsp.CurrentCamera
		if not char or not hrp or not hum or not cam then return end
		nexusBg.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + cam.CFrame.LookVector)
		local vel = calcCamDirMove(hum, cam) * (math.clamp(nexusSpeed, 1, 50) * 16) + Vector3.new(0, nexusVertHold * math.clamp(nexusSpeed, 1, 50) * 16, 0)
		nexusBv.Velocity, hrp.AssemblyLinearVelocity = vel, vel
	end)
end
local function destroyNexusGui()
	stopNexusLoop()
	if nexusCharConn then nexusCharConn:Disconnect(); nexusCharConn = nil end
	if nexusGuiInstance then pcall(function() nexusGuiInstance:Destroy() end); nexusGuiInstance = nil end
	destroyGui("NexusFlyGui")
	if nexusTglBtn then nexusTglBtn.Text = "FLY GUI: TẮT"; nexusTglBtn.BackgroundColor3 = Color3.fromRGB(16,54,38) end
end
