		{{t="1",k="1",bg=Color3.fromRGB(32,32,36),fg=Color3.fromRGB(255,255,255)},{t="2",k="2",bg=Color3.fromRGB(32,32,36),fg=Color3.fromRGB(255,255,255)},{t="3",k="3",bg=Color3.fromRGB(32,32,36),fg=Color3.fromRGB(255,255,255)},{t="=",k="=",bg=Color3.fromRGB(255,149,0),fg=Color3.fromRGB(255,255,255)}},
		{{t="00",k="00",bg=Color3.fromRGB(32,32,36),fg=Color3.fromRGB(255,255,255)},{t="0",k="0",bg=Color3.fromRGB(32,32,36),fg=Color3.fromRGB(255,255,255)},{t=",",k=",",bg=Color3.fromRGB(32,32,36),fg=Color3.fromRGB(255,255,255)}},
