local function new(cls, props, parent)
	local o = Instance.new(cls)
	for k, v in pairs(props or {}) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end
local function rad(o, r) new("UICorner", {CornerRadius = UDim.new(0, r)}, o) return o end
local function stk(o, c, t, tr) new("UIStroke", {Color = c, Thickness = t or 1, Transparency = tr or 0}, o) end
local function hrpOf(p) return p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") end
