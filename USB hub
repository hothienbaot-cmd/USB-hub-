		if gpe or not running or not dlCfg.vis then return end
		if inp.KeyCode==Enum.KeyCode.A or inp.KeyCode==Enum.KeyCode.Left then setLane(lane-1)
		elseif inp.KeyCode==Enum.KeyCode.D or inp.KeyCode==Enum.KeyCode.Right then setLane(lane+1) end
	end))
	table.insert(dlConns, win:GetPropertyChangedSignal("AbsolutePosition"):Connect(syncSidePos))
	table.insert(dlConns, win:GetPropertyChangedSignal("AbsoluteSize"):Connect(syncSidePos))

	local sliding = false
