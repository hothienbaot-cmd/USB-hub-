		local topH, botY = math.max(0.05, gapCenter - gapH*0.5), math.min(0.95, gapCenter + gapH*0.5)
		local topPipe = rad(new("Frame", {Size=UDim2.new(0.15,0,topH,0),Position=UDim2.new(xFrac,0,0,0),BackgroundColor3=Color3.fromRGB(58,184,78),BorderSizePixel=0,ZIndex=4}, pipeLayer), 4)
		local botPipe = rad(new("Frame", {Size=UDim2.new(0.15,0,1-botY,0),Position=UDim2.new(xFrac,0,botY,0),BackgroundColor3=Color3.fromRGB(58,184,78),BorderSizePixel=0,ZIndex=4}, pipeLayer), 4)
		table.insert(pipes, {x=xFrac, top=topPipe, bot=botPipe, topH=topH, botY=botY, scored=false})
	end
	local function prepareStartMenu()
		running, loseOverlay.Visible = false, false; clearPipes(); birdY, birdVy, invuln = 0.44, 0, 0
		bird.Position = UDim2.new(0.28,0,birdY,0); infoLbl.Text = (fpCfg.hard and "Khó (1 mạng)" or "Dễ (3 mạng)").." • Qua cột +1 điểm"
		menuOverlay.Visible = true; syncHud()
	end
	local function triggerLose(reason)
		running, menuOverlay.Visible = false, false; clearPipes(); birdY, birdVy, invuln = 0.44, 0, 0
		bird.Position = UDim2.new(0.28,0,birdY,0); syncHud()
		loseScoreLbl.Text = (reason and (reason.."\n") or "").."Điểm: "..fpScore.." • Best: "..fpBest; loseOverlay.Visible = true
	end
	local function startGame()
		fpScore, fpLives = 0, maxLives(); clearPipes(); birdY, birdVy, invuln = 0.44, -0.42, 0.35
		bird.Position = UDim2.new(0.28,0,birdY,0); spawnPipe(1.02); spawnPipe(1.56)
		menuOverlay.Visible, loseOverlay.Visible, running = false, false, true; syncHud()
	end
	local function flap()
		if not fpCfg.vis or not running then return end
		birdVy = -0.44; wing.Position = UDim2.new(0.44,0,0.34,0)
		task.delay(0.11, function() if wing then wing.Position = UDim2.new(0.44,0,0.52,0) end end)
	end
	local function loseLife(reason)
		if invuln > 0 then return end
		fpLives -= 1; invuln = 0.75; syncHud()
		if fpLives <= 0 then triggerLose(reason) else birdY, birdVy = 0.38, -0.22; bird.Position = UDim2.new(0.28,0,birdY,0) end
	end
	local function setSize(v)
		fpCfg.size = math.clamp(math.floor(v), 100, 300)
		win.Size = UDim2.new(0, fpCfg.size, 0, math.floor(fpCfg.size*1.25))
		local bSz = math.clamp(math.floor(fpCfg.size*0.1), 12, 28)
		bird.Size = UDim2.new(0, bSz, 0, math.floor(bSz*0.8)); refreshSideUi(); task.defer(syncSidePos)
	end
	local function setVis(s) fpCfg.vis, win.Visible, bar.Visible = s, s, s; if not s then running = false end; refreshSideUi() end
	fpSetVis = setVis

	startBtn.MouseButton1Click:Connect(startGame); retryBtn.MouseButton1Click:Connect(startGame); loseTitleBtn.MouseButton1Click:Connect(startGame)
	closeBtn.MouseButton1Click:Connect(destroyFlappy); offBtn.MouseButton1Click:Connect(destroyFlappy)
	hideBtn.MouseButton1Click:Connect(function() setVis(false) end); visBtn.MouseButton1Click:Connect(function() setVis(not fpCfg.vis) end)
	lockBtn.MouseButton1Click:Connect(function() fpCfg.lock = not fpCfg.lock; refreshSideUi() end)
	modeBtn.MouseButton1Click:Connect(function() fpCfg.hard = not fpCfg.hard; fpLives = maxLives(); refreshSideUi(); if not running and not loseOverlay.Visible then prepareStartMenu() else syncHud() end end)

	table.insert(fpConns, playArea.InputBegan:Connect(function(inp) if running and (inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch) then flap() end end))
	table.insert(fpConns, win:GetPropertyChangedSignal("AbsolutePosition"):Connect(syncSidePos))
	table.insert(fpConns, win:GetPropertyChangedSignal("AbsoluteSize"):Connect(syncSidePos))

	local sliding = false
	local function slideAt(x) setSize(100 + math.clamp((x-track.AbsolutePosition.X)/math.max(1,track.AbsoluteSize.X),0,1)*200) end
	table.insert(fpConns, track.InputBegan:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then sliding=true; slideAt(inp.Position.X) end end))
	table.insert(fpConns, Uis.InputChanged:Connect(function(inp) if sliding and (inp.UserInputType==Enum.UserInputType.MouseMovement or inp.UserInputType==Enum.UserInputType.Touch) then slideAt(inp.Position.X) end end))
	table.insert(fpConns, Uis.InputEnded:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then sliding=false end end))

	fpLoopConn = game:GetService("RunService").Heartbeat:Connect(function(dt)
		if not running or not fpCfg.vis then return end
		dt = math.min(dt, 0.05)
		if invuln > 0 then invuln = math.max(0, invuln-dt); bird.BackgroundTransparency = (math.floor(invuln*16)%2==0) and 0.45 or 0 else bird.BackgroundTransparency = 0 end
		birdVy += 1.35 * dt; birdY += birdVy * dt
		if birdY < 0.05 then birdY, birdVy = 0.05, 0 end
		if birdY >= 0.96 then loseLife("Chạm đất"); return end
		bird.Position = UDim2.new(0.28,0,birdY,0)

		local speed, rightmost = fpCfg.hard and 0.46 or 0.34, 0
		for i = #pipes, 1, -1 do
			local p = pipes[i]; p.x -= speed * dt
			p.top.Position, p.bot.Position = UDim2.new(p.x,0,0,0), UDim2.new(p.x,0,p.botY,0)
			if p.x > rightmost then rightmost = p.x end
			if not p.scored and p.x + 0.15 < 0.28 then p.scored = true; fpScore += 1; syncHud() end
			if (0.28+0.045 > p.x) and (0.28-0.045 < p.x+0.15) and ((birdY-0.035 < p.topH) or (birdY+0.035 > p.botY)) then loseLife("Đâm cột xanh"); return end
			if p.x < -0.2 then p.top:Destroy(); p.bot:Destroy(); table.remove(pipes, i) end
		end
		if rightmost < 0.54 then spawnPipe(math.max(1.02, rightmost + 0.52)) end
	end)

	setSize(fpCfg.size); prepareStartMenu(); task.defer(syncSidePos)
end

