local function calcCamDirMove(hum, cam)
	if not hum or not cam or hum.MoveDirection.Magnitude <= 0.01 then return Vector3.zero end
	local fL = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
	local rL = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)
	fL = fL.Magnitude > 0.001 and fL.Unit or Vector3.new(0, 0, -1)
	rL = rL.Magnitude > 0.001 and rL.Unit or Vector3.new(1, 0, 0)
	local d = cam.CFrame.LookVector * hum.MoveDirection:Dot(fL) + cam.CFrame.RightVector * hum.MoveDirection:Dot(rL)
	return d.Magnitude > 1 and d.Unit or d
end

