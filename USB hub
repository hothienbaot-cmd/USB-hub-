	local function syncHud() if snScore>snBest then snBest=snScore end; hudLbl.Text = snScore.."đ | 👑"..snBest end
	local function syncSidePos()
		local wPos, wSz = win.AbsolutePosition, win.AbsoluteSize
		local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280,720)
		local sx = wPos.X + wSz.X + 6
		if sx + bar.AbsoluteSize.X > vp.X - 6 then sx = math.max(6, wPos.X - bar.AbsoluteSize.X - 6) end
		bar.Position = UDim2.new(0, sx, 0, math.clamp(wPos.Y + 12, 6, vp.Y - bar.AbsoluteSize.Y - 6))
	end
	local function refreshSideUi()
		lockBtn.Text=snCfg.lock and "🔒 Lock" or "🔓 Unlock"; lockBtn.BackgroundColor3=snCfg.lock and Color3.fromRGB(145,45,45) or Color3.fromRGB(36,145,88); win.Draggable=not snCfg.lock
		visBtn.Text=snCfg.vis and "👁️ Ẩn" or "👁️ Hiện"; visBtn.BackgroundColor3=snCfg.vis and Color3.fromRGB(28,96,66) or Color3.fromRGB(92,58,18)
		local r = math.clamp((snCfg.size-100)/200, 0, 1)
		fill.Size, thumb.Position, szLbl.Text = UDim2.new(r,0,1,0), UDim2.new(r,0,0.5,0), "Size: "..snCfg.size.." (100-300)"
	end
	local function renderEntities()
		for _, f in ipairs(segFrames) do f:Destroy() end; table.clear(segFrames)
		if foodFrame then foodFrame:Destroy(); foodFrame = nil end
		local cf = 1 / GRID_N
		foodFrame = rad(new("Frame", {Size=UDim2.new(cf,-2,cf,-2),Position=UDim2.new((food.x-1)*cf,1,(food.y-1)*cf,1),BackgroundColor3=Color3.fromRGB(255,85,95),BorderSizePixel=0,ZIndex=5}, gridLayer), 999)
		for idx, seg in ipairs(snake) do
			local isHead = (idx == 1)
			table.insert(segFrames, rad(new("Frame", {Size=UDim2.new(cf,-2,cf,-2),Position=UDim2.new((seg.x-1)*cf,1,(seg.y-1)*cf,1),BackgroundColor3=isHead and Color3.fromRGB(120,255,165) or Color3.fromRGB(56,196,112),BorderSizePixel=0,ZIndex=isHead and 7 or 6}, gridLayer), isHead and 5 or 3))
		end
	end
	local function spawnFood()
		local free = {}
		for y=1,GRID_N do for x=1,GRID_N do
			local occ = false; for _, s in ipairs(snake) do if s.x==x and s.y==y then occ=true; break end end
			if not occ then table.insert(free, {x=x,y=y}) end
		end end
		if #free > 0 then local p = free[math.random(#free)]; food = {x=p.x, y=p.y} end
	end
	local function setDir(nx, ny) if (nx==-dir.x and ny==-dir.y) or (nx==0 and ny==0) then return end; nextDir = {x=nx, y=ny} end
	local function prepareMenu()
		running, loseOverlay.Visible, snScore, stepTimer = false, false, 0, 0
		dir, nextDir = {x=1,y=0}, {x=1,y=0}; snake = {{x=5,y=6},{x=4,y=6},{x=3,y=6}}; food = {x=9,y=6}
		startOverlay.Visible = true; syncHud(); renderEntities()
	end
	local function triggerLose(reason) running, startOverlay.Visible = false, false; syncHud(); loseScoreLbl.Text=(reason and (reason.."\n") or "").."Điểm: "..snScore.." • Best: "..snBest; loseOverlay.Visible = true end
	local function startGame()
		snScore, stepTimer = 0, 0; dir, nextDir = {x=1,y=0}, {x=1,y=0}; snake = {{x=5,y=6},{x=4,y=6},{x=3,y=6}}
		spawnFood(); startOverlay.Visible, loseOverlay.Visible, running = false, false, true; syncHud(); renderEntities()
	end
	local function stepSnake()
		dir = {x=nextDir.x, y=nextDir.y}
		local nx, ny = snake[1].x + dir.x, snake[1].y + dir.y
		if nx<1 or nx>GRID_N or ny<1 or ny>GRID_N then triggerLose("Đâm tường"); return end
		local eat = (nx==food.x and ny==food.y)
		for i=1, (eat and #snake or (#snake-1)) do if snake[i].x==nx and snake[i].y==ny then triggerLose("Tự cắn đuôi"); return end end
		table.insert(snake, 1, {x=nx, y=ny})
		if eat then snScore += 1; syncHud(); spawnFood() else table.remove(snake) end
		renderEntities()
	end
	local function setSize(v) snCfg.size=math.clamp(math.floor(v),100,300); win.Size=UDim2.new(0,snCfg.size,0,math.floor(snCfg.size*1.28)); refreshSideUi(); task.defer(syncSidePos) end
	local function setVis(s) snCfg.vis, win.Visible, bar.Visible = s, s, s; if not s then running = false end; refreshSideUi() end
