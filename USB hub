local SHIFT_OFFSET = Vector3.new(1.75, 0, 0)
local shiftGui, shiftLockBtn, shiftDelta, shiftStroke, shiftIcon = nil
local shiftActive, shiftConn, shiftCharConn = false, nil, nil
local function setShiftAutoRotate(lockRot) local h = humOf(LP); if h then h.AutoRotate = not lockRot end end
local function refreshShiftVisual()
	if not shiftStroke then return end
	shiftStroke.Color = shiftActive and Color3.fromRGB(60,235,140) or Color3.fromRGB(160,235,195)
	shiftLockBtn.BackgroundColor3 = shiftActive and Color3.fromRGB(28,96,66) or Color3.fromRGB(9,34,24)
	shiftLockBtn.BackgroundTransparency = shiftActive and 0.1 or 0.2
	shiftIcon.Text = shiftActive and "🔒" or "🔓"
	shiftDelta.Visible = shiftActive
end
local function stopShiftLockMode()
	shiftActive = false; refreshShiftVisual(); setShiftAutoRotate(false)
	if shiftConn then shiftConn:Disconnect(); shiftConn = nil end
end
local function startShiftLockMode()
	if shiftConn then shiftConn:Disconnect() end
	shiftActive = true; refreshShiftVisual()
	shiftConn = RunSvc.RenderStepped:Connect(function()
		local hum, hrp, cam = humOf(LP), hrpOf(LP), Wsp.CurrentCamera
		if not shiftActive or not hum or not hrp or not cam or hum.Health <= 0 then return end
		hum.AutoRotate = false; cam.CFrame = cam.CFrame * CFrame.new(SHIFT_OFFSET)
		local flat = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
		if flat.Magnitude > 0.001 then hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + flat.Unit) end
	end)
end
local function destroyShiftLockGui()
	stopShiftLockMode()
	if shiftCharConn then shiftCharConn:Disconnect(); shiftCharConn = nil end
	if shiftGui then pcall(function() shiftGui:Destroy() end); shiftGui = nil end
	destroyGui("ShiftLockGui"); shiftLockBtn, shiftDelta, shiftStroke, shiftIcon = nil
end
