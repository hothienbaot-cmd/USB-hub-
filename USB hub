	hideBtn.MouseButton1Click:Connect(function() setVis(false) end); visBtn.MouseButton1Click:Connect(function() setVis(not snCfg.vis) end)
	lockBtn.MouseButton1Click:Connect(function() snCfg.lock = not snCfg.lock; refreshSideUi() end)

	local tStart = nil
	table.insert(snConns, board.InputBegan:Connect(function(inp) if running and snCfg.vis and (inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch) then tStart = inp.Position end end))
	table.insert(snConns, board.InputEnded:Connect(function(inp)
		if not running or not snCfg.vis or not tStart then return end
		if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
			local dx, dy = inp.Position.X - tStart.X, inp.Position.Y - tStart.Y; tStart = nil
			if math.abs(dx)<10 and math.abs(dy)<10 then
				local rx = (inp.Position.X - board.AbsolutePosition.X) / math.max(1, board.AbsoluteSize.X)
				local ry = (inp.Position.Y - board.AbsolutePosition.Y) / math.max(1, board.AbsoluteSize.Y)
				if math.abs(rx-0.5) > math.abs(ry-0.5) then setDir(rx<0.5 and -1 or 1, 0) else setDir(0, ry<0.5 and -1 or 1) end
			elseif math.abs(dx) > math.abs(dy) then setDir(dx>0 and 1 or -1, 0) else setDir(0, dy>0 and 1 or -1) end
		end
	end))
	table.insert(snConns, Uis.InputBegan:Connect(function(inp, gpe)
		if gpe or not running or not snCfg.vis then return end
		if inp.KeyCode==Enum.KeyCode.W or inp.KeyCode==Enum.KeyCode.Up then setDir(0,-1)
		elseif inp.KeyCode==Enum.KeyCode.S or inp.KeyCode==Enum.KeyCode.Down then setDir(0,1)
		elseif inp.KeyCode==Enum.KeyCode.A or inp.KeyCode==Enum.KeyCode.Left then setDir(-1,0)
		elseif inp.KeyCode==Enum.KeyCode.D or inp.KeyCode==Enum.KeyCode.Right then setDir(1,0) end
	end))
	table.insert(snConns, win:GetPropertyChangedSignal("AbsolutePosition"):Connect(syncSidePos))
	table.insert(snConns, win:GetPropertyChangedSignal("AbsoluteSize"):Connect(syncSidePos))

	local sliding = false
	local function slideAt(x) setSize(100 + math.clamp((x-track.AbsolutePosition.X)/math.max(1,track.AbsoluteSize.X),0,1)*200) end
	table.insert(snConns, track.InputBegan:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then sliding=true; slideAt(inp.Position.X) end end))
	table.insert(snConns, Uis.InputChanged:Connect(function(inp) if sliding and (inp.UserInputType==Enum.UserInputType.MouseMovement or inp.UserInputType==Enum.UserInputType.Touch) then slideAt(inp.Position.X) end end))
	table.insert(snConns, Uis.InputEnded:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then sliding=false end end))

	snLoopConn = game:GetService("RunService").Heartbeat:Connect(function(dt)
		if not running or not snCfg.vis then return end
		dt = math.min(dt, 0.05); stepTimer += dt
		if stepTimer >= math.clamp(0.22 - snScore*0.006, 0.075, 0.22) then stepTimer = 0; stepSnake() end
	end)

	setSize(snCfg.size); prepareMenu(); task.defer(syncSidePos)
end

