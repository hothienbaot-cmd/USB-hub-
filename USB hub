		local wPos, wSz = win.AbsolutePosition, win.AbsoluteSize
		local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280,720)
		local sx = wPos.X + wSz.X + 6
		if sx + bar.AbsoluteSize.X > vp.X - 6 then sx = math.max(6, wPos.X - bar.AbsoluteSize.X - 6) end
		bar.Position = UDim2.new(0, sx, 0, math.clamp(wPos.Y + 12, 6, vp.Y - bar.AbsoluteSize.Y - 6))
	end

	local function refreshSideUi()
		lockBtn.Text = ttCfg.lock and "🔒 Lock" or "🔓 Unlock"
		lockBtn.BackgroundColor3 = ttCfg.lock and Color3.fromRGB(145,45,45) or Color3.fromRGB(36,145,88)
		win.Draggable = not ttCfg.lock
		visBtn.Text = ttCfg.vis and "👁️ Ẩn" or "👁️ Hiện"
		visBtn.BackgroundColor3 = ttCfg.vis and Color3.fromRGB(36,78,124) or Color3.fromRGB(92,58,18)
		local r = math.clamp((ttCfg.size - 100) / 200, 0, 1)
		fill.Size, thumb.Position, szLbl.Text = UDim2.new(r,0,1,0), UDim2.new(r,0,0.5,0), "Size: "..ttCfg.size.." (100-300)"
	end

	local function prepareMenu()
		running = false
		loseOverlay.Visible = false
		ttScore, timeLeft, spawnTimer = 0, 8.0, 0
		clearBalls()
		startOverlay.Visible = true
		syncHud()
	end

	local function triggerLose(reason)
		running = false
		clearBalls()
		startOverlay.Visible = false
		syncHud()
		loseBtn.Text = "💀 Bạn đã thua"
		loseScoreLbl.Text = (reason and (reason.."\n") or "").."Điểm: "..ttScore.." • Best: "..ttBest
		loseOverlay.Visible = true
	end

	local function spawnBall(isTrap)
		local bPx = math.clamp(math.floor(ttCfg.size * 0.13), 18, 36)
		local rx = 0.16 + math.random() * 0.68
		local ry = 0.16 + math.random() * 0.68
		local life = math.clamp(1.25 - ttScore * 0.015, 0.55, 1.25)
		local btn = rad(new("TextButton", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.new(0, bPx, 0, bPx),
			Position = UDim2.new(rx, 0, ry, 0),
			BackgroundColor3 = isTrap and Color3.fromRGB(235, 52, 68) or Color3.fromRGB(72, 225, 145),
			Text = isTrap and "💣" or "🎯",
			TextColor3 = Color3.fromRGB(255, 255, 255),
			Font = Enum.Font.GothamBlack,
			TextSize = math.max(10, math.floor(bPx * 0.45)),
			ZIndex = 14,
		}, ballLayer), 999)
		stk(btn, isTrap and Color3.fromRGB(255, 165, 175) or Color3.fromRGB(220, 255, 235), 1.3)

		local entry = {ui = btn, age = 0, life = life, isTrap = isTrap}
		table.insert(balls, entry)

		btn.MouseButton1Click:Connect(function()
			if not running or not ttCfg.vis then return end
			for i, item in ipairs(balls) do
				if item == entry then
					if item.ui then item.ui:Destroy() end
					table.remove(balls, i)
					break
				end
			end
			if isTrap then
				ttScore = math.max(0, ttScore - 2)
				timeLeft = math.max(0, timeLeft - 0.8)
				syncHud()
				if ttScore <= 0 then
					triggerLose("Bấm trúng bóng bẫy")
				end
			else
				ttScore += 1
				timeLeft = math.min(9.5, timeLeft + 0.35)
				syncHud()
			end
		end)
	end

	local function spawnWave()
		spawnBall(false)
		if math.random() < math.clamp(0.32 + ttScore * 0.02, 0.32, 0.75) then
			spawnBall(true)
		end
	end

	local function startGame()
		ttScore, timeLeft, spawnTimer = 0, 8.0, 0
		clearBalls()
		startOverlay.Visible = false
		loseOverlay.Visible = false
		running = true
		syncHud()
		spawnWave()
	end

	local function setSize(v)
		ttCfg.size = math.clamp(math.floor(v), 100, 300)
		win.Size = UDim2.new(0, ttCfg.size, 0, math.floor(ttCfg.size * 1.28))
		refreshSideUi()
		task.defer(syncSidePos)
	end

local function setVis(s)
		ttCfg.vis = s
		win.Visible = s
		bar.Visible = s
		if not s then running = false end
		refreshSideUi()
	end
	ttSetVis = setVis

	startBtn.MouseButton1Click:Connect(startGame)
	retryBtn.MouseButton1Click:Connect(startGame)
	loseBtn.MouseButton1Click:Connect(startGame)
	closeBtn.MouseButton1Click:Connect(destroyTapTarget)
	offBtn.MouseButton1Click:Connect(destroyTapTarget)
	hideBtn.MouseButton1Click:Connect(function() setVis(false) end)
	visBtn.MouseButton1Click:Connect(function() setVis(not ttCfg.vis) end)
	lockBtn.MouseButton1Click:Connect(function() ttCfg.lock = not ttCfg.lock; refreshSideUi() end)

	table.insert(ttConns, win:GetPropertyChangedSignal("AbsolutePosition"):Connect(syncSidePos))
	table.insert(ttConns, win:GetPropertyChangedSignal("AbsoluteSize"):Connect(syncSidePos))

	local sliding = false
	local function slideAt(x)
		local r = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
		setSize(100 + r * 200)
	end
	table.insert(ttConns, track.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			sliding = true; slideAt(inp.Position.X)
		end
	end))
	table.insert(ttConns, Uis.InputChanged:Connect(function(inp)
		if sliding and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
			slideAt(inp.Position.X)
		end
	end))
	table.insert(ttConns, Uis.InputEnded:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end))

	ttLoopConn = game:GetService("RunService").Heartbeat:Connect(function(dt)
		if not running or not ttCfg.vis then return end
		dt = math.min(dt, 0.05)
		timeLeft -= dt
		if timeLeft <= 0 then
			timeLeft = 0
			syncHud()
			triggerLose("Hết giờ")
			return
		end
		syncHud()

		local interval = math.clamp(0.72 - ttScore * 0.015, 0.24, 0.72)
		spawnTimer -= dt
		if spawnTimer <= 0 then
			spawnWave()
			spawnTimer = interval
		end

		for i = #balls, 1, -1 do
			local b = balls[i]
			b.age += dt
			if b.age >= b.life then
				if b.ui then b.ui:Destroy() end
				table.remove(balls, i)
			elseif b.ui then
				local ratio = math.clamp(1 - b.age / b.life, 0.25, 1)
				b.ui.BackgroundTransparency = (1 - ratio) * 0.45
			end
		end
	end)

	setSize(ttCfg.size)
	prepareMenu()
	task.defer(syncSidePos)
end

