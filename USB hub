end
local function getHeadPart(model)
	if not model or not model.Parent then return nil end
	local h = model:FindFirstChild("Head"); if h and h:IsA("BasePart") then return h end
	for _, d in ipairs(model:GetDescendants()) do if d:IsA("BasePart") and d.Name:lower():find("head") then return d end end
	return model:FindFirstChild("HumanoidRootPart")
end
local function refreshAimNpcs()
	table.clear(aimNpcCache)
	for _, d in ipairs(Wsp:GetDescendants()) do
		if d:IsA("Model") and d ~= LP.Character and not Plrs:GetPlayerFromCharacter(d) then
			local hum = d:FindFirstChildOfClass("Humanoid"); local head = hum and hum.Health > 0 and getHeadPart(d)
			if head then table.insert(aimNpcCache, {hum=hum, head=head, nameLower=d.Name:lower()}) end
		end
	end
end
local function findAimHead(originPos)
	local filter = aimByNameOn and aimTargetName:gsub("^%s*(.-)%s*$","%1"):lower() or ""
	local namedHead, bestNamed, nearHead, bestNear = nil, math.huge, nil, math.huge
	for _, p in ipairs(Plrs:GetPlayers()) do
		if p ~= LP and p.Character then
			local hum = p.Character:FindFirstChildOfClass("Humanoid"); local head = hum and hum.Health > 0 and getHeadPart(p.Character)
			if head then
				local d = (head.Position - originPos).Magnitude
				if d < bestNear then bestNear, nearHead = d, head end
				if filter ~= "" and (p.Name:lower():find(filter,1,true) or p.DisplayName:lower():find(filter,1,true)) and d < bestNamed then bestNamed, namedHead = d, head end
			end
		end
	end
	if os.clock() - aimLastScan >= 0.35 then aimLastScan = os.clock(); pcall(refreshAimNpcs) end
	for i = #aimNpcCache, 1, -1 do
		local it, head = aimNpcCache[i], aimNpcCache[i].head
		if not head or not head.Parent or not it.hum or not it.hum.Parent or it.hum.Health <= 0 then table.remove(aimNpcCache, i)
		else
			local d = (head.Position - originPos).Magnitude
			if d < bestNear then bestNear, nearHead = d, head end
			if filter ~= "" and it.nameLower:find(filter,1,true) and d < bestNamed then bestNamed, namedHead = d, head end
		end
	end
	return (filter ~= "" and namedHead) or nearHead
end
