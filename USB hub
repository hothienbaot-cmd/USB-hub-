			else
				local fd = Vector3.new(it.root.Position.X - cf.Position.X, 0, it.root.Position.Z - cf.Position.Z).Magnitude
				if it.kind == "Entity" and fd <= RADAR_RADIUS_STUDS and fd < nearest then nearest = fd end
				local allowed = (it.kind == "DeadPlayer" and allowX) or (it.kind == "Entity" and allowNQ)
