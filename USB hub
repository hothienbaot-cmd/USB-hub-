	table.insert(dlConns, track.InputBegan:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then sliding=true; slideAt(inp.Position.X) end end))
	table.insert(dlConns, Uis.InputChanged:Connect(function(inp) if sliding and (inp.UserInputType==Enum.UserInputType.MouseMovement or inp.UserInputType==Enum.UserInputType.Touch) then slideAt(inp.Position.X) end end))
	table.insert(dlConns, Uis.InputEnded:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then sliding=false end end))

	dlLoopConn = game:GetService("RunService").Heartbeat:Connect(function(dt)
		if not running or not dlCfg.vis then return end
		dt = math.min(dt, 0.05); elapsed += dt; dlScore += dt * 10; syncHud()
		local speed = math.clamp(0.75 + elapsed*0.035, 0.75, 1.95)
		spawnTimer -= dt; if spawnTimer <= 0 then spawnObstacle(); spawnTimer = math.clamp(0.78 - elapsed*0.015, 0.36, 0.78) end
		for i = #obstacles, 1, -1 do
			local o = obstacles[i]; o.y += speed * dt; o.ui.Position = UDim2.new(LANE_X[o.lane],0,o.y,0)
			if o.lane==lane and math.abs(o.y - 0.84) < 0.085 then triggerLose(); return end
			if o.y > 1.12 then o.ui:Destroy(); table.remove(obstacles, i) end
		end
	end)

	setSize(dlCfg.size); prepareMenu(); task.defer(syncSidePos)
end

